# Normalize text to LF in the repo; checkout stays LF on all platforms.
* text=auto eol=lf

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf
.cursorrules text eol=lf
.htmlhintrc text eol=lf
.stylelintrc.json text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary assets — never convert
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
